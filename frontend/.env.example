# Copy to .env.local for local development.

# Base URL of the FastAPI backend. Read routes are open; write routes need X-API-Key when the backend sets DETECTION_API_KEY.
NEXT_PUBLIC_COBRA_API_URL=http://localhost:8000

# Public views mask IP addresses to the /24 (203.0.113.45 shows as 203.0.113.•). Set to true ONLY for a local session you control;
# the app then shows a persistent "Unmasked" banner.
NEXT_PUBLIC_REVEAL_IP=false

# Used by the nav and footer GitHub links.
NEXT_PUBLIC_REPO_URL=https://github.com/Gokul0211/Geospatial-Camera-Exposure-Intelligence-Platform

# Branch used for source links (results.md anchors). The repository default branch is master.
NEXT_PUBLIC_REPO_BRANCH=master

# Canonical origin for metadata and the Open Graph image.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Basemap for the console map: a MapLibre style URL (for example one that points at your own PMTiles file; see BASEMAP.md).
# Leave empty for a plain dark canvas with the device layer on it, which needs no tile hosting.
NEXT_PUBLIC_MAP_STYLE_URL=

# /console-preview shows the console with clearly labelled demo data, for design review. It is always available in `next dev`
# and returns 404 in a production build unless this is true.
NEXT_PUBLIC_DESIGN_PREVIEW=false
